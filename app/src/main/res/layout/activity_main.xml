<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/jasny_niebieski"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/kolotla1"
        android:layout_width="737dp"
        android:layout_height="544dp"
        android:layout_marginTop="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kolo1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/kolotla4"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/kolotla2"
        android:layout_width="482dp"
        android:layout_height="441dp"
        android:layout_marginTop="128dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kolo2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/kolotla1"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/kolotla3"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="64dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kolo1"
        app:layout_constraintBottom_toBottomOf="@+id/tytul"
        app:layout_constraintEnd_toStartOf="@+id/tytul"
        app:layout_constraintHorizontal_bias="0.77"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/kolotla4"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kolo1"
        app:layout_constraintBottom_toBottomOf="@+id/podtytul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.29"
        app:layout_constraintStart_toEndOf="@+id/podtytul"
        app:layout_constraintTop_toBottomOf="@+id/tytul"
        app:layout_constraintVertical_bias="0.23000002" />

    <ImageView
        android:id="@+id/tytul"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/tytul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/podtytul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Samodzielny Fanowski Dodatek Do Gry HITSTER"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tytul"
        android:layout_marginHorizontal="50dp"
        android:gravity="center">
    </TextView>

    <Button
        android:id="@+id/guzikZKartami"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/circular_button"
        android:text="POBIERZ PLIK Z KARTAMI"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="20dp" />

    <Button
        android:id="@+id/guzikDoZasad"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circular_button"
        android:text="ZASADY GRY"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/guzikZKartami"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guzikDoGry" />

    <Button
        android:id="@+id/guzikDoGry"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/circular_button"
        android:text="GRAJ"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/podtytul" />

    <Button
        android:id="@+id/guzikDoInfo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/circular_button"
        android:text="?"
        android:textColor="@color/black"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>